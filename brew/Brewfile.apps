# ╔══════════════════════════════════════════════════════════════╗
# ║  GUI-приложения.                                              ║
# ║  brew bundle --file=brew/Brewfile.apps                        ║
# ╚══════════════════════════════════════════════════════════════╝

# ---------- рабочее окружение ----------
cask "iterm2"       # терминал: сплиты, профили, поиск
cask "docker-desktop" # Docker Desktop (cask docker переименован)
cask "raycast"      # запуск, буфер обмена, сниппеты, окна, свои скрипты

# ---------- повседневное ----------
cask "espanso"      # текстовый экспандер, конфиг в YAML
cask "hiddenbar"    # спрятать лишние иконки в меню-баре
cask "appcleaner"   # удаление приложений вместе с их файлами
cask "keka"         # архиватор (rar, 7z)

# Quick Look для Markdown: пробел в Finder рисует .md, а не показывает текст.
# Включается скриптом macos/quicklook.sh — одной установки cask мало.
# Даёт ещё и qlmarkdown_cli: рендер .md в html из терминала.
cask "qlmarkdown"

# Уже установлены вручную — перечислены, чтобы Brewfile описывал
# машину целиком и новая разворачивалась одной командой.
cask "iina"         # видеоплеер
# obsidian поставлен вручную: brew не может «усыновить» его (chmod: Operation not
# permitted). Чтобы перевести под brew: удалить /Applications/Obsidian.app и
# раскомментировать строку.
# cask "obsidian"   # заметки в Markdown
