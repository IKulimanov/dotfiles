# ╔══════════════════════════════════════════════════════════════╗
# ║  Базовый набор: то, на что опирается конфиг шелла и git.      ║
# ║  brew bundle --file=brew/Brewfile.core                        ║
# ╚══════════════════════════════════════════════════════════════╝

# ---------- обязательное для самих dotfiles ----------
brew "stow"         # GNU Stow — симлинк-менеджер, которым ставятся конфиги
                    # (формула называется именно stow, не gnu-stow)

# Шрифт — НЕ опционален: .p10k.zsh собран в режиме nerdfont-v3,
# и eza --icons тоже рисует глифы. Без него в терминале квадраты.
# После установки выбрать в iTerm2: Profiles → Text → Font → MesloLGS NF
cask "font-meslo-lg-nerd-font"

# ---------- CLI ----------
brew "bat"          # cat с подсветкой синтаксиса
brew "eza"          # современная замена ls
brew "ripgrep"      # быстрый поиск по содержимому
brew "fd"           # быстрый поиск файлов по имени
brew "fzf"          # fuzzy finder (Ctrl+R, Ctrl+T, Alt+C)
brew "zoxide"       # умный cd — z <часть имени>
brew "jq"           # JSON в командной строке
brew "htop"         # мониторинг процессов
brew "tldr"         # краткие примеры вместо man
brew "trash"        # удаление в Корзину (обратимое) вместо rm -i

# ---------- разработка ----------
brew "git"          # свежий git вместо системного 2.39 (Apple)
brew "neovim"
brew "tree-sitter-cli" # нужен nvim-treesitter (ветка main) для сборки парсеров
brew "gh"           # GitHub CLI
brew "git-delta"    # диффы side-by-side с подсветкой
brew "lazygit"      # TUI для git: стейджинг, ветки, rebase, конфиг в lazygit/
brew "tig"          # история, blame и ветки в консоли, конфиг в tig/
brew "shellcheck"   # проверка shell-скриптов (make lint)
brew "direnv"       # авто-загрузка .envrc

# ---------- kubernetes ----------
# Доступ к кластерам — через корпоративный Keycloak (OIDC), поэтому
# нужен kubelogin: kubectl сам браузер для логина не открывает.
brew "kubernetes-cli"  # свежий kubectl вместо того, что кладёт Docker Desktop
brew "int128/kubelogin/kubelogin" # плагин kubectl-oidc_login, вход через Keycloak
brew "k9s"          # TUI: активность подов, логи, рестарт — как lazygit для кластера
brew "stern"        # логи сразу со всех подов по маске; kubectl logs умеет только один
brew "kubectx"      # kubectx / kubens — переключение контекста и namespace
brew "kubecolor"    # подсветка вывода kubectl

# mise — версии Go / Node / Python по каталогу.
# Пришёл на замену rbenv, который висел в конфиге, хотя Ruby не используется.
# Не нужен — удалите строку и уберите activate из conf.d/20-tools.zsh.
brew "mise"
