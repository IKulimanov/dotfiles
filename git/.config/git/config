# ─────────────────────────────────────────────────────────────
#  Личные данные (имя, почта) СОЗНАТЕЛЬНО не хранятся в этом файле.
#  Их создаёт install.sh в ~/.config/git/identity — он не в git.
#  Там же живут правила includeIf для рабочих аккаунтов.
#  Пересоздать: ./install.sh  (шаг «Git: идентичности»)
# ─────────────────────────────────────────────────────────────
[include]
	path = identity

[core]
	autocrlf = input
	pager = delta

[init]
	defaultBranch = main

[pull]
	rebase = true              # pull --rebase по умолчанию

[push]
	autoSetupRemote = true     # push новой ветки без -u
	default = current
	followTags = true          # аннотированные теги уезжают вместе с коммитами

[fetch]
	prune = true               # удалять мёртвые remote-ветки при fetch

[merge]
	conflictstyle = zdiff3     # показывать base при конфликтах

[diff]
	algorithm = histogram      # лучший алгоритм диффов
	colorMoved = default       # подсвечивать перемещённый код

[rebase]
	autoStash = true           # stash перед rebase, unstash после

[rerere]
	enabled = true             # запоминать решения конфликтов
	autoUpdate = true          # и сразу применять их

[column]
	ui = auto                  # branch/status в колонки

[branch]
	sort = -committerdate      # свежие ветки сверху

[tag]
	sort = version:refname

[help]
	autocorrect = prompt       # спросить, а не выполнить молча

[interactive]
	diffFilter = delta --color-only

[delta]
	dark = true
	navigate = true
	side-by-side = true
	line-numbers = true

[alias]
	co = checkout
	br = branch
	ci = commit
	st = status
	lg = log --oneline --graph --decorate -20
	undo = reset --soft HEAD~1
	amend = commit --amend --no-edit
	wip = !git add -A && git commit -m 'wip'
	branches = branch -a --sort=-committerdate
	stashes = stash list
	# что накопилось в ветке относительно main
	up = log --oneline --graph main..HEAD
	# ветки, чей upstream удалён
	gone = "!git fetch -p && git branch -vv | awk '/: gone]/{print $1}'"
	# чей это код
	who = shortlog -sne --
	# найти коммит по изменённой строке
	pickaxe = log -S
	# какой идентичностью подписан текущий репозиторий
	whoami = "!f(){ printf '%s <%s>\\n' \"$(git config user.name)\" \"$(git config user.email)\"; }; f"
