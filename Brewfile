# ╔══════════════════════════════════════════════════════════╗
# ║  Brewfile — декларативный список пакетов                ║
# ║  Установка: brew bundle --file=Brewfile                 ║
# ║  Выборочно: brew install <name>                         ║
# ╚══════════════════════════════════════════════════════════╝

# ---------- CLI: базовые инструменты ----------
brew "gnu-stow"     # симлинк-менеджер для dotfiles
brew "bat"          # cat с подсветкой синтаксиса
brew "eza"          # современная замена ls (иконки, дерево)
brew "ripgrep"      # быстрый grep по файлам
brew "fd"           # быстрый find
brew "fzf"          # fuzzy finder (Ctrl+R, Ctrl+T)
brew "zoxide"       # умный cd — запоминает часто посещаемые каталоги
brew "jq"           # парсер JSON в командной строке
brew "htop"         # мониторинг процессов
brew "tldr"         # краткие примеры команд вместо man

# ---------- CLI: разработка ----------
brew "neovim"       # текстовый редактор
brew "gh"           # GitHub CLI (PR, issues, actions)
brew "git-delta"    # красивые диффы в git (side-by-side, подсветка)
brew "lazygit"      # TUI-интерфейс для git
brew "direnv"       # авто-загрузка переменных окружения из .envrc

# ---------- GUI приложения ----------
cask "iterm2"       # терминал с поддержкой сплитов, профилей, tmux
cask "docker"       # Docker Desktop
